# Copy to .env and replace both required values before starting the stack.
POSTGRES_DB=eidpfad
POSTGRES_USER=eidpfad
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Local binding for direct health checks. Caddy reaches the server internally.
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=8080
LOG_LEVEL=info

# Required only with docker-compose.vps.yml. The DNS A/AAAA record must point here.
SERVER_DOMAIN=game.example.com
